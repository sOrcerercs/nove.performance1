# Auth.js session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Postgres connection string.
# Leave unset to use the in-process PGlite store in .pglite/ — no setup needed.
#
# Supabase: use the SESSION pooler (port 5432) locally for migrations and seed,
# and the TRANSACTION pooler (port 6543) in Vercel. See the README.
DATABASE_URL=

# Optional: password given to every seeded account by `npm run seed`.
# Leave unset and a strong one is generated and printed once per run.
SEED_PASSWORD=
